# ScanForProfit Environment Variables Template

# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub — only .env.example

# PROXY BACKEND
PROXY_URL=https://your-proxy-url-here.com

# GOOGLE ANALYTICS 4
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# STRIPE (if implementing payments)
STRIPE_PUBLIC_KEY=pk_test_XXXXX
STRIPE_SECRET_KEY=sk_test_XXXXX

# EMAIL PROVIDER (if using Resend, Mailchimp, etc.)
MAILCHIMP_API_KEY=xxxxxxxxxxxxx
MAILCHIMP_LIST_ID=xxxxxxxx

# ANTHROPIC API (direct, if not using proxy)
ANTHROPIC_API_KEY=sk-ant-v0-xxxxxxx

# N8N WEBHOOKS
NEXT_PUBLIC_N8N_WEBHOOK_URL=https://scanforprofit.app.n8n.cloud/webhook/YOUR-PATH-HERE
NEXT_PUBLIC_N8N_EARLY_ACCESS_WEBHOOK_URL=

# LOCAL DEVELOPMENT
NODE_ENV=development
DEBUG=false
