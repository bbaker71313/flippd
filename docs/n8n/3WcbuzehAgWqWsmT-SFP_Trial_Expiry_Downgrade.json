            "name": "Header Auth account 3"
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"from\":\"ScanForProfit <hello@scanforprofit.com>\",\"to\":[\"{{ $(\"Preserve User Data\").item.json.userEmail }}\"],\"subject\":\"Your trial ended — here is what you still have\",\"html\":\"<p>Your 7-day trial is over. You are now on the free Scout tier: 25 scans and 10 inventory items per month, no charge.</p><p>Upgrade to Hustle for $19/month and get unlimited scans, up to 500 items, and the full Growth Agent.</p>\"}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "rKGIJ2QkZqnU0Sjx",
          "name": "Header Auth account"
        }
      }
