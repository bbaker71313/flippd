# ScanForProfit Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub — only .env.example

# ── Mobile (Expo) ──────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://dqgfpchkheznvanfgsmx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Web (Next.js) ──────────────────────────────────────────────────────────────
# Same values as above — Next.js needs its own prefix
NEXT_PUBLIC_SUPABASE_URL=https://dqgfpchkheznvanfgsmx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (server-side only — never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# ── Analytics ──────────────────────────────────────────────────────────────────
# PostHog: posthog.com → your project → Project Settings → Project API Key
NEXT_PUBLIC_POSTHOG_KEY=
# Also replace __POSTHOG_KEY__ in apps/web/public/index.html manually

# ── n8n Webhooks ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_N8N_EARLY_ACCESS_WEBHOOK_URL=https://scanforprofit.app.n8n.cloud/webhook/sfp-early-access-capture

# ── Supabase Edge Function Secrets (set via CLI, not .env) ────────────────────
# Run these commands once — they are stored in Supabase, not in this file:
#
#   supabase secrets set JWT_SECRET="<Supabase JWT Secret from dashboard → Project Settings → API → JWT Secret>" --project-ref dqgfpchkheznvanfgsmx
#   supabase secrets set ANTHROPIC_API_KEY="sk-ant-..." --project-ref dqgfpchkheznvanfgsmx
#   supabase secrets set RESEND_API_KEY="re_..." --project-ref dqgfpchkheznvanfgsmx
#   supabase secrets set STRIPE_SECRET_KEY="sk_live_..." --project-ref dqgfpchkheznvanfgsmx
#   supabase secrets set STRIPE_WEBHOOK_SECRET="whsec_..." --project-ref dqgfpchkheznvanfgsmx
#   supabase secrets set EBAY_CLIENT_ID="<your ScanForProfit eBay client ID from developer.ebay.com>" --project-ref dqgfpchkheznvanfgsmx
#
# JWT_SECRET must equal the Supabase project JWT secret — not a custom value.
# STRIPE_WEBHOOK_SECRET: get from Stripe Dashboard → Developers → Webhooks after
# adding endpoint: https://dqgfpchkheznvanfgsmx.supabase.co/functions/v1/stripe-webhook
