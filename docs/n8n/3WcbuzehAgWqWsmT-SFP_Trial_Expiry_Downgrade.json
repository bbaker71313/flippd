      "position": [
        672,
        0
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "uid",
              "name": "userId",
              "value": "={{ $json.id }}",
              "type": "number"
            },
            {
              "id": "uemail",
              "name": "userEmail",
              "value": "={{ $json.email }}",
              "type": "string"
            },
            {
              "id": "uname",
              "name": "userName",
              "value": "={{ $json.name }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "e1995835-3ad6-427d-b69c-7e9b31d67c8a",
      "name": "Downgrade Tier to Scout",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        896,
        0
      ],
      "parameters": {
        "method": "PATCH",
        "url": "=https://dqgfpchkheznvanfgsmx.supabase.co/rest/v1/users?id=eq.{{ $json.userId }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $vars.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $vars.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"tier\":\"scout\"}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "mamo9gyI6frT6OWz",
          "name": "Header Auth account 2"
        }
      }
    },
