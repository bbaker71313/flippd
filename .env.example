# ScanForProfit Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub — only .env.example

# ── Mobile (Expo) ──────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://dqgfpchkheznvanfgsmx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Web (Next.js) ──────────────────────────────────────────────────────────────
# Same values as above — Next.js needs its own prefix
NEXT_PUBLIC_SUPABASE_URL=https://dqgfpchkheznvanfgsmx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (server-side only — never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# ── Analytics ──────────────────────────────────────────────────────────────────
# PostHog: posthog.com → your project → Project Settings → Project API Key
NEXT_PUBLIC_POSTHOG_KEY=
# Also replace __POSTHOG_KEY__ in apps/web/public/index.html manually

# ── n8n Webhooks ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_N8N_EARLY_ACCESS_WEBHOOK_URL=https://scanforprofit.app.n8n.cloud/webhook/sfp-early-access-capture

# ── Supabase Edge Function Secrets (set via CLI, not .env) ────────────────────
# Run these commands once — they are stored in Supabase, not in this file:
#
#   supabase secrets set JWT_SECRET="<Supabase JWT Secret from dashboard → Project Settings → API → JWT Secret>" --project-ref dqgfpchkheznvanfgsmx
#   supabase secrets set ANTHROPIC_API_KEY="sk-ant-..." --project-ref dqgfpchkheznvanfgsmx
#   supabase secrets set RESEND_API_KEY="re_..." --project-ref dqgfpchkheznvanfgsmx
#   supabase secrets set STRIPE_SECRET_KEY="sk_live_..." --project-ref dqgfpchkheznvanfgsmx
#   supabase secrets set STRIPE_WEBHOOK_SECRET="whsec_..." --project-ref dqgfpchkheznvanfgsmx
#   supabase secrets set EBAY_CLIENT_ID="<your ScanForProfit eBay client ID from developer.ebay.com>" --project-ref dqgfpchkheznvanfgsmx
#
# JWT_SECRET must equal the Supabase project JWT secret — not a custom value.
# STRIPE_WEBHOOK_SECRET: get from Stripe Dashboard → Developers → Webhooks after
# adding endpoint: https://dqgfpchkheznvanfgsmx.supabase.co/functions/v1/stripe-webhook
#
# Stripe price IDs — single authoritative source for both stripe-checkout and
# stripe-webhook (supabase/functions/_shared/stripePricing.ts). Monthly price
# IDs must already be set for checkout to work at all. Annual price IDs are
# optional per-tier — if unset, annual checkout for that tier fails closed
# with a "Price ID not configured" error rather than falling back to monthly
# or inventing a price (P1-B). Do not add a 6th tier or rename these keys
# without updating stripePricing.ts.
#   supabase secrets set STRIPE_PRICE_HUSTLE_MONTHLY="price_..." --project-ref dqgfpchkheznvanfgsmx
#   supabase secrets set STRIPE_PRICE_HUSTLE_ANNUAL="price_..."  --project-ref dqgfpchkheznvanfgsmx
#   supabase secrets set STRIPE_PRICE_STACK_MONTHLY="price_..."  --project-ref dqgfpchkheznvanfgsmx
#   supabase secrets set STRIPE_PRICE_STACK_ANNUAL="price_..."   --project-ref dqgfpchkheznvanfgsmx
#   supabase secrets set STRIPE_PRICE_EMPIRE_MONTHLY="price_..." --project-ref dqgfpchkheznvanfgsmx
#   supabase secrets set STRIPE_PRICE_EMPIRE_ANNUAL="price_..."  --project-ref dqgfpchkheznvanfgsmx
#
# eBay sync pagination safety ceiling (P2-24) — optional, defaults to 25 pages
# (5000 records) per list endpoint (offers, active listings, orders,
# inventory-title enrichment) before a sync is truthfully reported as
# truncated rather than claimed complete.
#   supabase secrets set EBAY_SYNC_MAX_PAGES="25" --project-ref dqgfpchkheznvanfgsmx
#
# eBay OAuth (ebay-oauth function) — required for eBay connect/listing/sync.
# EBAY_SANDBOX ("true"/unset) selects which credential pair and API host
# (supabase/functions/_shared/ebayClient.ts's ebayUrls()) every eBay-calling
# function uses — sandbox and prod credentials are never mixed.
#   supabase secrets set EBAY_SANDBOX="false" --project-ref dqgfpchkheznvanfgsmx
#   supabase secrets set EBAY_CLIENT_SECRET="<from developer.ebay.com>" --project-ref dqgfpchkheznvanfgsmx
#   supabase secrets set EBAY_RUNAME="<eBay RuName redirect identifier>" --project-ref dqgfpchkheznvanfgsmx
#   supabase secrets set EBAY_SANDBOX_CLIENT_ID="<sandbox client ID>" --project-ref dqgfpchkheznvanfgsmx
#   supabase secrets set EBAY_SANDBOX_CLIENT_SECRET="<sandbox client secret>" --project-ref dqgfpchkheznvanfgsmx
#   supabase secrets set EBAY_SANDBOX_RUNAME="<sandbox RuName>" --project-ref dqgfpchkheznvanfgsmx
#
# Verified market-data pipeline (P0, 2026-08-26) — SoldComps sold-history
# provider. SOLD_COMPS_API_KEY is required for verified sold-price evidence;
# without it, scans fall back to the AI-estimate path (marketDataSource:
# 'ai_estimate') rather than failing. SOLDCOMPS_API_BASE_URL is optional,
# defaults to https://api.sold-comps.com/v1/scrape.
#   supabase secrets set SOLD_COMPS_API_KEY="<from sold-comps.com>" --project-ref dqgfpchkheznvanfgsmx
#   supabase secrets set SOLDCOMPS_API_BASE_URL="https://api.sold-comps.com/v1/scrape" --project-ref dqgfpchkheznvanfgsmx
#
# IDENTIFICATION_PROVIDER — optional, selects the item-identification
# strategy in _shared/itemIdentification.ts. Leave unset for the default.
#   supabase secrets set IDENTIFICATION_PROVIDER="<provider name>" --project-ref dqgfpchkheznvanfgsmx
#
# cron function — required to authorize scheduled invocations (email queue
# drain, re-engagement emails); export-reminder requires the same value as
# its own x-cron-secret header check.
#   supabase secrets set CRON_SECRET="<random secret, shared with whatever schedules cron>" --project-ref dqgfpchkheznvanfgsmx
#
# FRONTEND_URL — optional, used to build links in transactional emails
# (verification, password reset, export reminders). Defaults to the
# production app.html URL if unset.
#   supabase secrets set FRONTEND_URL="https://scanforprofit.com/app.html" --project-ref dqgfpchkheznvanfgsmx
#
# RESEND_FROM_EMAIL — optional, the From address for transactional email via
# Resend (RESEND_API_KEY above). Must be a verified sender/domain in Resend.
#   supabase secrets set RESEND_FROM_EMAIL="ScanForProfit <noreply@scanforprofit.com>" --project-ref dqgfpchkheznvanfgsmx
#
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY inside Edge Functions are
# auto-injected by the Supabase runtime — do not set these as secrets
# yourself; they are unrelated to the SUPABASE_SERVICE_ROLE_KEY above (that
# one is for the Next.js server, a different runtime).
