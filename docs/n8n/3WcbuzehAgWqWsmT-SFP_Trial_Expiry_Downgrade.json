    {
      "id": "a6c36057-19b2-4ef2-a44a-decde239aa9f",
      "name": "Get Expired Trial Users",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        224,
        80
      ],
      "parameters": {
        "method": "GET",
        "url": "https://dqgfpchkheznvanfgsmx.supabase.co/rest/v1/users",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "tier",
              "value": "eq.trial"
            },
            {
              "name": "trial_ends_at",
              "value": "=lt.{{ $now.toISO() }}"
            },
            {
              "name": "select",
              "value": "id,email,name"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $vars.SUPABASE_ANON_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $vars.SUPABASE_ANON_KEY }}"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "mamo9gyI6frT6OWz",
          "name": "Header Auth account 2"
        }
      }
    },
    {
      "id": "37f57e57-c014-4a20-b6a7-58cc9252b7aa",
